APP_NAME=EduTrack AI
ENVIRONMENT=production

# Supabase > Connect > Session pooler. Mantenha ?sslmode=require ao final.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:SUA_SENHA@aws-SUA_REGIAO.pooler.supabase.com:5432/postgres?sslmode=require

# Gere uma chave longa e aleatória. O Render também pode gerá-la automaticamente.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_MINUTES=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-aplicativo-google
SMTP_FROM_EMAIL=seu-email@gmail.com

# Informe a URL HTTPS que o Render atribuir ao serviço, ou seu domínio próprio.
FRONTEND_URL=https://seu-servico.onrender.com
COOKIE_SECURE=true

# Não crie dados demonstrativos na base de produção.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=Demo-Segura-123
